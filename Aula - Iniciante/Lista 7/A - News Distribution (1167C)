def find(x, pais):
    if pais[x] < 0:
        return x
    pais[x] = find(pais[x], pais)
    return pais[x]

def union(a, b, pais):
    raiz_a = find(a, pais)
    raiz_b = find(b, pais)
    
    if raiz_a == raiz_b:
        return False
    
    if pais[raiz_b] < pais[raiz_a]:
        raiz_a, raiz_b = raiz_b, raiz_a
    
    pais[raiz_a] += pais[raiz_b]
    pais[raiz_b] = raiz_a
    return True

def tamanho(x, pais):
    raiz = find(x, pais)
    return -(pais[raiz])

def main():
    n, m = map(int, input().split())
    pais = [-1]*(n+1)
    for _ in range(m):
        entrada = list(map(int, input().split()))
        for i in range(2, len(entrada)):
            union(entrada[i-1], entrada[i], pais)
    
    saida = [str(tamanho(i, pais)) for i in range(1,n+1)]
    print(" ".join(saida))
    
main()