import sys
sys.setrecursionlimit(3000)

def dfs_profundidade(cadeiaComando, nodo):
    profundidade = 0
    for e in nodo:
        profundidade_nodo_e = dfs_profundidade(cadeiaComando, cadeiaComando[e])
        profundidade = max(profundidade, profundidade_nodo_e + 1)
    return profundidade
            
def main():
    n = int(input())
    cadeiaComando = [[] for _ in range(n+1)]
    
    for i in range(1, n+1):
        p = int(input())
        if p == -1:
            cadeiaComando[0].append(i)
        else:
            cadeiaComando[p].append(i)

    print(dfs_profundidade(cadeiaComando, cadeiaComando[0]))

main()