def main():
    s = input()
    n = len(s)
    pilha = []
    for c in s:
        if len(pilha) == 0:
            pilha.append(c)
        else:
            if c == pilha[-1]:
                pilha.append(c)
            else:
                pilha.pop()
    
    print(n-len(pilha))

main()

