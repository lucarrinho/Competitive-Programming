def find(x, pais):
    if pais[x] < 0:
        return x
    pais[x] = find(pais[x], pais)
    return pais[x]

def union(u, v, pais):
    raiz_u = find(u, pais)
    raiz_v = find(v, pais)
    
    if raiz_u == raiz_v:
        return False
    if pais[raiz_v] < pais[raiz_u]:
        raiz_u, raiz_v = raiz_v, raiz_u
    
    pais[raiz_u] += pais[raiz_v]
    pais[raiz_v] = raiz_u
    return True

def conta_filhos(pais):
    acc = 0
    for no in pais:
        if no >= 0:
            acc += 1
    return acc

n, m = map(int, input().split())
pais = [-1]*n
for _ in range(m):
    x, y = map(int, input().split())
    union(x-1, y-1, pais)

reativos = conta_filhos(pais)
print(2**reativos)