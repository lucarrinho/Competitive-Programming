
def canPlaceFlowers(flowerbed, n):
    flowers = 0
    for i in range(1, len(flowerbed)-1):
        if flowers == n:
            print("true")
            return True
        if flowerbed[i] == 0:
            if flowerbed[i-1] == 0 and flowerbed[i+1] == 0:
                flowerbed[i] = 1
                flowers += 1
    if flowers == n:
        print("true")
        return True
    print("false")
    return False    

flowerbed = list(map(int, input().strip("[]").split(",")))
n = int(input())
canPlaceFlowers(flowerbed, n)