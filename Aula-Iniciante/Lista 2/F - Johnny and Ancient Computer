def n_operacoes(a,b):
    operacoes = 0
    while a < b:
        if a << 3 <= b:
            operacoes += 1
            a = a << 3
        elif a << 2 <= b:
            operacoes += 1
            a = a << 2
        elif a << 1 <= b:
            operacoes += 1
            a = a << 1
        else: return -1
    return operacoes

def main():
    t = int(input())
    for _ in range(t):
        ai, bi = map(int, input().split())
        b = max(ai,bi)
        a = min(ai,bi)
        print(n_operacoes(a,b))

main()